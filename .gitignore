# Dependencies
/vendor
node_modules/

# Build artifacts
/dist
/public/build
/public/hot

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.backup
.env.production

# Credentials / secrets (never commit)
*.pem
*.key
*.p12
*.pfx
*.jks
*.p8
*.pub
*.crt
*.cer
credentials*.json
*service-account*.json
*serviceaccount*.json
*vault*.json
*.token
auth.json

# Logs
*.log
/storage/logs/*
!/storage/logs/.gitignore

# Cache / temp
.phpunit.cache/
.phpunit.result.cache
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
/storage/*.key

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
npm-debug.log*
yarn-error.log*
coverage/