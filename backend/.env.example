APP_NAME="JPC Portal API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Multiple dev-server workers (POSIX/Linux/macOS only).
# Requires: php artisan serve --no-reload
# Ignored on Windows: the PHP built-in server cannot fork ("forking is not
# supported on this platform"). Use Laragon nginx + php-cgi for concurrency there.
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acadtrack_db
DB_USERNAME=root
DB_PASSWORD=

# Development sample data (Phase 3.1-D) — NEVER enable on production.
# SEED_DEVELOPMENT_DATA defaults to true outside the production environment.
SEED_DEVELOPMENT_DATA=true
SEED_ACADEMIC_YEAR_START=2026-06-01
SEED_ACADEMIC_YEAR_END=2027-05-31
# Development-only passwords; provide strong values in local environments.
SEED_ADMIN_PASSWORD=
SEED_HR_PASSWORD=
SEED_DEPARTMENT_HEAD_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---------- AI Report Processing (Phase 3.3-K) ----------
# Deterministic offline engines are the default so the pipeline runs without
# external accounts. Switch to the real integrations in a secured .env only.
#   OCR_PROVIDER=fake | google_vision
#   AI_PROVIDER=fake  | openai | <any OpenAI-compatible endpoint via AI_ENDPOINT>
OCR_PROVIDER=fake
AI_PROVIDER=fake
AI_MODEL=jpc-analysis-v1
AI_ANALYSIS_VERSION=v1.0
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1
AI_TIMEOUT=120
# AI_ENDPOINT=
# AI_API_KEY=
# AI_ORGANIZATION=

# Google Cloud Vision (used only when OCR_PROVIDER=google_vision).
# GCLOUD_API_KEY is the lightweight route (annotateImage REST). Service-account
# creds via GOOGLE_APPLICATION_CREDENTIALS require token exchange, see docs.
# GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1
# GOOGLE_VISION_API_KEY=
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

OCR_LANGUAGE=en
OCR_MIN_CONFIDENCE=0.55
REFERENCE_ANCHOR_DEFAULT=0.35
SIMILARITY_SIMILAR_THRESHOLD=0.7
SIMILARITY_HIGH_SIMILAR_THRESHOLD=0.85
AI_REPORTS_QUEUE=default
AI_REPORTS_MAX_INPUT_CHARS=60000
# Upload limits (KB) and private storage for report documents.
REPORT_FILES_DISK=local
REPORT_FILES_DIRECTORY=reports
REPORT_MAX_FILE_SIZE_KB=51200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
